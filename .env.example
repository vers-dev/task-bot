# ── Telegram ──────────────────────────────────────────────
# Получить у @BotFather: /newbot → токен вида 123456:ABC-DEF...
# ВАЖНО (группы + альбомы): выключи Privacy Mode у бота —
#   @BotFather → /setprivacy → выбрать бота → Disable, затем перезайди в группу.
TELEGRAM_BOT_TOKEN=

# Необязательно: ограничить бота списком чатов/групп (chat id через запятую).
# id группы можно увидеть в логах бота или у @getidsbot. Пусто = все чаты.
ALLOWED_CHAT_IDS=

# Закреплять карточку задачи после /issue (нужно право бота «Закреплять сообщения»). true/false.
PIN_ISSUES=true

# Кто может «Одобрить»/«Отклонить» — Telegram user id через запятую.
# Пусто = любой в разрешённых чатах (рекомендуется задать!). user id — у @getidsbot.
OFFER_APPROVERS=

# Метка инстанса для /whoami (напр. local / prod). Пусто = hostname машины/контейнера.
BOT_INSTANCE=

# Путь к SQLite-базе (отложенные /comment). В Docker держи на volume: /app/data/bot.db
DB_PATH=data/bot.db

# Прокси для api.telegram.org, если Telegram недоступен напрямую (напр. RU-сервер).
# Формат: http://user:pass@host:port  (HTTP/HTTPS-прокси). Пусто = напрямую.
TELEGRAM_PROXY=

# ── Webhook (опционально) ─────────────────────────────────
# Если WEBHOOK_URL задан — бот работает на webhook (Telegram сам шлёт апдейты),
# вместо долгого polling. ОТПРАВКА всё равно идёт через прокси (api.telegram.org).
# Условие: серверы Telegram должны доставать прод по HTTPS (проверь getWebhookInfo).
# WEBHOOK_URL — публичный HTTPS-адрес за nginx (секрет в пути усложняет угадывание).
WEBHOOK_URL=
# Порт, который слушает бот за nginx (наружу не публикуем, проксируем с 127.0.0.1).
WEBHOOK_PORT=8090
# Секрет: Telegram шлёт его в заголовке X-Telegram-Bot-Api-Secret-Token (валидируем).
WEBHOOK_SECRET=

# ── Trello ────────────────────────────────────────────────
# API key: создай Power-Up на https://trello.com/power-ups/admin → вкладка «API Key».
TRELLO_API_KEY=
# Token: по ссылке «Token» на странице API Key (или authorize-URL со scope=read,write,
# expiration=never). Токен = доступ ко всему аккаунту, храни как секрет, в git не клади.
TRELLO_TOKEN=
# ID доски или shortLink из её URL: https://trello.com/b/<shortLink>/... (напр. a1B2c3D4).
TRELLO_BOARD_ID=
# Необязательно: прокси для api.trello.com, если недоступен напрямую. Пусто = напрямую.
TRELLO_PROXY=

# Имена колонок под статусы (резолвятся в id на старте; создать: npm run trello:init).
TRELLO_LIST_TODO=Задачи
TRELLO_LIST_DONE=Готово
TRELLO_LIST_CANCELLED=Отменено

# Метки. Custom Fields на бесплатном тарифе Trello платные, поэтому:
#   «Создатель» — строкой в описании карточки (@username автора, автоматически);
#   «Одобрение» — метками + колонка «Отменено» для отклонённых.
# «Предложение» — маркер /offer (== «ожидает»). «Одобрено» — ставится при одобрении.
TRELLO_LABEL_OFFER=Предложение
TRELLO_LABEL_APPROVED=Одобрено

# Метки-категории (через запятую) — заводятся на доске скриптом trello:init.
TRELLO_CATEGORY_LABELS=Backend,Frontend
