{
  "name": "task-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot for creating/commenting/completing tasks in Trello or YouGile",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "init": "tsx scripts/board-init.ts",
    "trello:init": "tsx scripts/board-init.ts",
    "yougile:init": "tsx scripts/board-init.ts",
    "yougile:auth": "tsx scripts/yougile-auth.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "https-proxy-agent": "^9.1.0",
    "node-fetch": "^2.7.0",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/node-fetch": "^2.6.13",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
